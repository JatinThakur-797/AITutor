# =============================================================================
# PathAI Unified Environment Configuration Template
# Copy this file to .env at the root or per service and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL 8.0)
# -----------------------------------------------------------------------------
DB_NAME=aitutor
DB_USER=aitutor
DB_PASSWORD=aitutor_password
DB_ROOT_PASSWORD=root_password

# JDBC connection URL (used by local standalone execution or custom environments)
# Docker Compose overrides this to point to the internal container 'mysql:3306'
DB_URL=jdbc:mysql://localhost:3306/aitutor?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=aitutor
MYSQL_PASSWORD=aitutor_password

# -----------------------------------------------------------------------------
# Microservice Internal Defense Secret (Gateway -> Downstream validation)
# All microservices validate the 'X-Gateway-Secret' header against this value.
# -----------------------------------------------------------------------------
APP_GATEWAY_SECRET=replace_with_a_secure_random_internal_secret_here
INTERNAL_SECRET=replace_with_a_secure_random_internal_secret_here
APP_INTERNAL_SECRET=replace_with_a_secure_random_internal_secret_here

# -----------------------------------------------------------------------------
# JWT & Authentication Configuration
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48 (minimum 256 bits required by HS512/HS256)
JWT_SECRET=replace_with_a_secure_random_jwt_signing_secret_minimum_32_characters_here
APP_JWT_SECRET=replace_with_a_secure_random_jwt_signing_secret_minimum_32_characters_here
JWT_ISSUER=aitutor-user-service
APP_JWT_ISSUER=aitutor-user-service

# -----------------------------------------------------------------------------
# Frontend Client & CORS Configuration
# -----------------------------------------------------------------------------
BASE_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
VITE_ENABLE_CHAT_STREAMING=false

# -----------------------------------------------------------------------------
# OAuth2 Social Login Providers
# -----------------------------------------------------------------------------
# Google OAuth2 (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth2 (GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# -----------------------------------------------------------------------------
# AI Service (Spring AI + Groq Cloud OpenAI-compatible API)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct
AI_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Redis Configuration (Token Bucket Rate Limiting & Lesson Caching)
# Local host port: 6380 (mapped from container 6379)
# Inside Docker Compose: REDIS_HOST=redis, REDIS_PORT=6379
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Eureka Discovery Registry
# -----------------------------------------------------------------------------
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# -----------------------------------------------------------------------------
# Optional Integrations
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=
