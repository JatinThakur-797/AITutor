# =============================================================================
# LearningPathGenerator Service - Environment Configuration Template
# =============================================================================
SERVER_PORT=8082

# Database
DB_URL=jdbc:mysql://localhost:3306/aitutor?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=aitutor
MYSQL_PASSWORD=aitutor_password
DB_USER=aitutor
DB_PASSWORD=aitutor_password

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Internal Service Defense Secret (must match Gateway)
APP_INTERNAL_SECRET=replace_with_a_secure_random_internal_secret_here
INTERNAL_SECRET=replace_with_a_secure_random_internal_secret_here
APP_GATEWAY_SECRET=replace_with_a_secure_random_internal_secret_here

# Optional Curated Video Links API
YOUTUBE_API_KEY=

# Service Discovery
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
