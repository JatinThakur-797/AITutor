# =============================================================================
# User-Service - Environment Configuration Template
# =============================================================================
SERVER_PORT=8081

# Database
DB_URL=jdbc:mysql://localhost:3306/aitutor?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=aitutor
MYSQL_PASSWORD=aitutor_password
DB_USER=aitutor
DB_PASSWORD=aitutor_password

# Application Base URL (frontend URL for OAuth2 redirects)
BASE_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Internal Service Defense Secret (must match Gateway)
INTERNAL_SECRET=3b5234cd94a6aaf7618ec79ca4d4ecff21d248d4fd43f3cf
APP_GATEWAY_SECRET=3b5234cd94a6aaf7618ec79ca4d4ecff21d248d4fd43f3cf

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_jwt_signing_secret_minimum_32_characters_here
APP_JWT_SECRET=replace_with_a_secure_random_jwt_signing_secret_minimum_32_characters_here
JWT_ISSUER=aitutor-user-service
APP_JWT_ISSUER=aitutor-user-service

# OAuth2 Providers
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Service Discovery
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
